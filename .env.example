# Copy this file to .env and fill in real values. Never commit .env.
# Names may change; Kushal owns this file. Announce changes in the team chat.

# LLM server (AMD Token Factory or our own vLLM on AMD GPUs)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# Return mock data from every part (no models, no data needed)
MOCK_MODE=true

# Backend API
API_HOST=0.0.0.0
API_PORT=8080
